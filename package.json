{
  "name": "tracker",
  "version": "0.0.1",
  "description": "API-first, self-hosted workout planning and logging with a muscle ledger and mobile web client",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:local": "tsx scripts/configure-local.ts",
    "db:up": "docker compose up -d",
    "db:migrate": "tsx scripts/database.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "import:build": "tsx scripts/import-data.ts",
    "import:local": "tsx scripts/import-local.ts",
    "api:generate": "tsx scripts/generate-openapi.ts && openapi-typescript public/openapi.json -o contracts/api.d.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.12",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.4",
    "kysely": "^0.29.7",
    "lucide-react": "^1.60.0",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "3.6.7",
    "workflow": "5.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
